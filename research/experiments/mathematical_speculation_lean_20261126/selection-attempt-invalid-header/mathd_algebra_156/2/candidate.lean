theorem mathd_algebra_156 (x y : ℝ) (f g : ℝ → ℝ) (h₀ : ∀ t, f t = t ^ 4)
    (h₁ : ∀ t, g t = 5 * t ^ 2 - 6) (h₂ : f x = g x) (h₃ : f y = g y) (h₄ : x ^ 2 < y ^ 2) :
    y ^ 2 - x ^ 2 = 1 := by
  rw [h₀] at h₂ h₃
  simp_all only [h₀, h₁, mul_one, mul_zero, sub_zero, sub_eq_zero]
  ring_nf
  apply mul_left_cancel₀ (sub_ne_zero.mpr h₄.ne)
  ring_nf
  nlinarith

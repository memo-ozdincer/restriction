theorem mathd_numbertheory_457 (n : ℕ) (h₀ : 0 < n) (h₁ : 80325 ∣ n !) : 17 ≤ n := by
  have h₀' : 0 < n ! := Nat.factorial_pos n
  rw [Nat.dvd_iff_mod_eq_zero] at h₁
  norm_num at h₁

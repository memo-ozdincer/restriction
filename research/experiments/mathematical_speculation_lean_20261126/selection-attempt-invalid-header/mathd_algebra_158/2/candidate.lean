theorem mathd_algebra_158 (a : ℕ) (h₀ : Even a)
    (h₁ : ↑(∑ k in Finset.range 8, 2 * k + 1) - ↑(∑ k in Finset.range 5, a + 2 * k) = (4 : ℤ)) :
    a = 8 := by
  simp only [even_iff_two_dvd, Nat.succ_le_iff, Nat.succ_sub_succ_eq_sub,
    add_right_inj] at *
  norm_num [Finset.sum_range_succ, add_right_comm] at h₁
  omega
